# Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# ============================================
# RapidAPI Configuration (for market data)
# ============================================
# Get your API key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/real-time-finance-data
RAPIDAPI_KEY=your_rapidapi_key_here

# These hosts are pre-configured - do not change
RAPIDAPI_HOST=real-time-finance-data.p.rapidapi.com
RAPIDAPI_HOST_FALLBACK=yahoo-finance166.p.rapidapi.com

# ============================================
# Google Gemini API (for AI classification)
# ============================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY_PORTFOLIO=your_gemini_api_key_here
